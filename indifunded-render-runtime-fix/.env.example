# =====================================================================
# IndiFunded environment variables  (copy to ".env" for local use)
# ".env" is git-ignored. NEVER put real keys in this example file.
# On Render, type these in the dashboard instead (Environment tab).
# =====================================================================

# ---------- Supabase: PUBLIC values (safe in the browser) ----------
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
SUPABASE_JWKS_URL=https://YOUR-PROJECT-REF.supabase.co/auth/v1/.well-known/jwks.json
# The website reads these two at BUILD time. Same values as above. PUBLIC ONLY.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# ---------- Supabase: PRIVATE (server only - never prefix with VITE_) ----------
# Supabase dashboard > Project Settings > API Keys > "Secret keys"
SUPABASE_SECRET_KEY=sb_secret_PASTE_YOUR_REAL_SECRET_KEY_HERE

# ---------- Login sessions ----------
# Any long random text. Keep it the same between deploys, or everyone is logged out.
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string
# Optional overrides for the admin login
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---------- Razorpay (use your EXISTING values, unchanged) ----------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------- Optional features (only if you use them) ----------
GEMINI_API_KEY=
GMAIL_USER=
GMAIL_APP_PASSWORD=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# ---------- Safety switch ----------
# In production the app REFUSES to run on temporary in-memory storage.
# Leave this unset. (Setting it to "true" would allow data loss on restart.)
# ALLOW_MEMORY_STORE=false
